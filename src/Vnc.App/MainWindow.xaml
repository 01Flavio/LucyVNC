<Window x:Class="Vnc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LucyVNC Manager" Icon="Assets/LucyVNC.ico"
        Height="610" Width="1120" MinHeight="520" MinWidth="800"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="4,6,4,24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/LucyVNC-Icon.png" Width="42" Height="42" Stretch="Uniform" Margin="0,0,9,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LucyVNC" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="REMOTE WORKSPACE" FontSize="9" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="ComputersNavigation" Style="{StaticResource NavigationButton}" Tag="computers"
                            Click="Navigate_Click" ToolTip="Computadores" AutomationProperties.Name="Computadores">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconComputer}" Width="19" Height="19" Fill="{StaticResource Accent}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Computadores" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecentNavigation" Style="{StaticResource NavigationButton}" Tag="recent"
                            Click="Navigate_Click" ToolTip="Recentes" AutomationProperties.Name="Recentes">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRecent}" Width="19" Height="19" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Recentes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavoritesNavigation" Style="{StaticResource NavigationButton}" Tag="favorites"
                            Click="Navigate_Click" ToolTip="Favoritos" AutomationProperties.Name="Favoritos">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFavorite}" Width="19" Height="19" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Favoritos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavigation" Style="{StaticResource NavigationButton}" Tag="settings"
                            Click="Navigate_Click" ToolTip="Configurações" AutomationProperties.Name="Configurações">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Width="19" Height="19" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Configurações" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SessionsNavigation" Style="{StaticResource NavigationButton}" Tag="sessions"
                            Click="Navigate_Click" ToolTip="Sessões abertas" AutomationProperties.Name="Sessões abertas">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSessions}" Width="19" Height="19" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Sessões abertas" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource SurfaceElevated}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,12,0,2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Segurança local" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </StackPanel>
                        <TextBlock Text="VNC clássico não cifra o tráfego. Prefira loopback ou VPN confiável."
                                   FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Computadores" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Gerencie seus destinos e abra sessões remotas."
                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
                <Border x:Name="SearchContainer" Grid.Column="1" Background="{StaticResource InputSurface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="7" Height="36" Width="190" Margin="12,0,8,0">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Fill="{StaticResource TextSecondary}"
                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" ToolTip="Buscar computador" TextChanged="SearchBox_TextChanged"
                                     Style="{StaticResource QuickConnectInput}" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Buscar computador..." Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="NewComputer_Click" AutomationProperties.Name="Novo computador"
                        ToolTip="Cadastrar computador">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Width="14" Height="14" Fill="{StaticResource TextPrimary}"
                              Stretch="Uniform" Margin="0,0,7,0" />
                        <TextBlock Text="Novo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconComputer}" Width="18" Height="18" Fill="{StaticResource Accent}"
                              Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Conexão rápida" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <TextBox x:Name="DirectHostBox" Style="{StaticResource QuickConnectInput}"
                                 ToolTip="Endereço IP ou hostname" Margin="0"
                                 VerticalContentAlignment="Center" TextChanged="DirectHostBox_TextChanged" />
                        <TextBlock x:Name="DirectHostPlaceholder" Text="IP ou hostname..." Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="11,0,0,0" FontSize="11" IsHitTestVisible="False" />
                    </Grid>
                    <TextBox x:Name="DirectPortBox" Grid.Column="2" Style="{StaticResource QuickConnectInput}"
                             Text="5900" ToolTip="Porta TCP" Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Click="ConnectAddress_Click"
                            AutomationProperties.Name="Conectar destino">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Width="12" Height="12" Fill="{StaticResource TextPrimary}"
                                  Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="Conectar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid x:Name="ComputerPage" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="276" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Seus computadores" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="GroupFilterBox" Grid.Column="1" ToolTip="Filtrar por grupo"
                                      SelectionChanged="GroupFilterBox_SelectionChanged">
                                <ComboBoxItem Content="Todos os grupos" Tag="" />
                            </ComboBox>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,5">
                            <Button Content="Conectar" Style="{StaticResource CompactButton}" Click="ConnectSelected_Click" AutomationProperties.Name="Conectar computador selecionado" />
                            <Button Content="Favorito" Style="{StaticResource CompactButton}" Click="ToggleFavorite_Click" />
                            <Button Content="Duplicar" Style="{StaticResource CompactButton}" Click="DuplicateComputer_Click" />
                            <Button Content="Excluir" Style="{StaticResource CompactButton}" Click="DeleteComputer_Click" />
                            <Button Content="Importar arquivo(s)" Style="{StaticResource CompactButton}" Click="ImportConnections_Click" />
                            <Button Content="Importar pasta .vnc" Style="{StaticResource CompactButton}" Click="ImportVncFolder_Click" />
                            <Button Content="Exportar conexões" Style="{StaticResource CompactButton}" Click="ExportConnections_Click" />
                            <Button Content="Exportar selecionada como .vnc" Style="{StaticResource CompactButton}" Click="ExportVncConnection_Click" />
                            <ComboBox x:Name="SortBox" Width="142" Margin="2,2,0,2" ToolTip="Ordenar computadores"
                                      SelectionChanged="SortBox_SelectionChanged">
                                <ComboBoxItem Content="Nome" Tag="name" IsSelected="True" />
                                <ComboBoxItem Content="Última conexão" Tag="recent" />
                                <ComboBoxItem Content="Grupo" Tag="group" />
                            </ComboBox>
                        </WrapPanel>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="ComputerGrid" SelectionMode="Extended" SelectionChanged="ComputerGrid_SelectionChanged"
                                     MouseDoubleClick="ConnectSelected_Click" KeyboardNavigation.TabNavigation="Continue">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LucyCard}" Padding="13" Margin="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="9" Background="#2A1D3A"
                                                        VerticalAlignment="Top">
                                                    <Path Data="{StaticResource IconComputer}" Width="21" Height="21"
                                                          Fill="{StaticResource Accent}" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="  ★" Foreground="{StaticResource Accent}" FontSize="13"
                                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding ConnectionHost}" Foreground="{StaticResource TextSecondary}"
                                                               FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Port, StringFormat='TCP {0}'}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text="{Binding Group, StringFormat='  ·  {0}'}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LastResult, StringFormat='Última conexão: {0}'}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondary}"
                                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                        Click="ConnectCard_Click" ToolTip="Conectar a este computador"
                                                        AutomationProperties.Name="Conectar a este computador"
                                                        VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconPlay}" Width="13" Height="13"
                                                          Fill="{StaticResource Accent}" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="ComputersEmptyState" Style="{StaticResource LucyCard}" Margin="8"
                                    Padding="28" Visibility="Visible" IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                                    <Path Data="{StaticResource IconComputer}" Width="38" Height="38"
                                          Fill="{StaticResource AccentMuted}" Stretch="Uniform"
                                          HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="Sua lista começa aqui" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Cadastre um computador ou conecte-se por IP ou hostname para iniciar uma sessão."
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,7,0,14" />
                                    <Button Content="Adicionar computador" Style="{StaticResource PrimaryButton}"
                                            Click="NewComputer_Click" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Style="{StaticResource LucyCard}" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="EditorTitle" Text="Novo computador" FontSize="17"
                                           FontWeight="SemiBold" Margin="0,0,0,14" />
                                <TextBlock Text="Nome amigável" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="NameBox" />
                                <TextBlock Text="Hostname (opcional)" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="HostnameBox" />
                                <TextBlock Text="Endereço IP (opcional)" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="IpAddressBox" />
                                <TextBlock Text="Porta TCP" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="ComputerPortBox" Text="5900" />
                                <TextBlock Text="Grupo / categoria" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBox x:Name="GroupBox" />
                                <TextBlock Text="Preferência de visualização" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <ComboBox x:Name="ViewPreferenceBox" Margin="0,4,0,10">
                                    <ComboBoxItem Content="Ajustar à janela" Tag="fit" IsSelected="True" />
                                    <ComboBoxItem Content="Escala 100%" Tag="100%" />
                                </ComboBox>
                                <CheckBox x:Name="FavoriteBox" Content="Adicionar aos favoritos" Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Salvar computador" Style="{StaticResource PrimaryButton}" Click="SaveComputer_Click" />
                                    <Button Content="Limpar" Style="{StaticResource CompactButton}" Click="NewComputer_Click" />
                                </StackPanel>
                                <Button x:Name="RemoveCredentialButton" Content="Remover credencial lembrada"
                                        Style="{StaticResource CompactButton}" Click="RemoveSavedCredential_Click"
                                        IsEnabled="False" Margin="0,7,0,0" />
                                <TextBlock Text="Senhas não são gravadas no banco local. O armazenamento de credenciais exige consentimento."
                                           FontSize="10" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,11,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid>
                        <DataGrid x:Name="HistoryGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Destino" Binding="{Binding Host}" Width="*" />
                                <DataGridTextColumn Header="Porta" Binding="{Binding Port}" Width="90" />
                                <DataGridTextColumn Header="Data" Binding="{Binding ConnectedUtc}" Width="220" />
                                <DataGridTextColumn Header="Duração (ms)" Binding="{Binding DurationMilliseconds}" Width="130" />
                                <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="HistoryEmptyState" Style="{StaticResource LucyCard}" Padding="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="Seu histórico aparecerá aqui" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="As conexões autenticadas ficam registradas neste dispositivo."
                                           Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Border Style="{StaticResource LucyCard}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Preferências locais" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Banco SQLite em %LOCALAPPDATA%\LucyVNC\lucy.db. O banco contém computadores, preferências e histórico; senhas não são gravadas."
                                       Margin="0,12,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="A captura e SendInput requerem uma sessão Windows interativa. Desktop seguro, UAC, logon e sessões não interativas não são suportados."
                                       Foreground="{StaticResource Warning}" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DatabaseStatus" Text="" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="SessionsPage" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="OpenWorkspaceButton" Content="Abrir janela de sessões" Style="{StaticResource PrimaryButton}" Click="OpenWorkspace_Click"
                                    AutomationProperties.Name="Abrir janela de sessões" />
                            <Button Content="Desconectar selecionada" Style="{StaticResource CompactButton}" Click="CloseSelectedSession_Click" />
                            <Button Content="Reconectar" Style="{StaticResource CompactButton}" Click="ReconnectSelectedSession_Click" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="SessionList" MouseDoubleClick="OpenWorkspace_Click">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Computador" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="Destino" Binding="{Binding Endpoint}" Width="*" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding DisplayStatus}" Width="2*" />
                                    <DataGridTextColumn Header="Conectada desde" Binding="{Binding ConnectedAtDisplay}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border x:Name="SessionsEmptyState" Style="{StaticResource LucyCard}" Padding="24"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel>
                                    <TextBlock Text="Nenhuma sessão remota" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Conecte-se a um computador para iniciar uma sessão."
                                               Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
