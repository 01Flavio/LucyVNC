                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <SolidColorBrush x:Key="Canvas" Color="#100D18" />
    <SolidColorBrush x:Key="Surface" Color="#191323" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="#21192F" />
    <SolidColorBrush x:Key="Primary" Color="#8B35E8" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#A855F7" />
    <SolidColorBrush x:Key="Accent" Color="#C084FC" />
    <SolidColorBrush x:Key="AccentMuted" Color="#765095" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F3FF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A9A0BC" />
    <SolidColorBrush x:Key="Line" Color="#382B4B" />
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="Error" Color="#FB7185" />
    <SolidColorBrush x:Key="Warning" Color="#FACC15" />
    <SolidColorBrush x:Key="InputSurface" Color="#130F1C" />

